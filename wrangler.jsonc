{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    // The Worker only runs for model weights; every other path is a free static asset.
    "run_worker_first": ["/models/*"]
  },
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "depth-light-models" }
  ]
}
